{
  "name": "pda-platform",
  "version": "1.0.0",
  "description": "Plataforma de transformacion digital de Perfect Dance Academy - monolito modular contenerizado",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:auth": "SERVICE=auth node src/server.js",
    "start:catalogo": "SERVICE=catalogo node src/server.js",
    "start:inscripcion": "SERVICE=inscripcion node src/server.js",
    "start:pagos": "SERVICE=pagos node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci --coverage --reporters=default --reporters=jest-junit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "redis": "^4.6.14"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}

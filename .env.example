# =============================================================================
# Perfect Dance Academy - Plantilla de variables de entorno
# Copiar como .env y completar los valores. El archivo .env NO se versiona.
# =============================================================================

# --- Aplicacion -------------------------------------------------------------
# Modulo que expone este contenedor: monolito | auth | catalogo | inscripcion | pagos
SERVICE=monolito
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Base de datos PostgreSQL (RNF-026) -------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pda
POSTGRES_USER=pda_app
POSTGRES_PASSWORD=cambiar_en_cada_entorno
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10

# --- Redis (cache y bloqueo temporal de cupo) -------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SEGUNDOS=60
BLOQUEO_CUPO_SEGUNDOS=300

# --- Seguridad (RNF-015, RNF-016, RNF-020) ----------------------------------
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRACION=30m
BCRYPT_ROUNDS=12
CORS_ORIGENES=http://localhost:5173

# --- Pasarela de pagos (RF-030, RNF-017) ------------------------------------
# La plataforma nunca almacena datos de tarjeta: se delegan a la pasarela PCI DSS
PASARELA_URL=https://sandbox.pasarela.example.com
PASARELA_API_KEY=clave_de_sandbox
PASARELA_COMERCIO_ID=pda-sandbox

# --- Integracion continua / AWS ---------------------------------------------
AWS_REGION=us-east-1
ECR_REGISTRO=000000000000.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORIO=pda-platform
IMAGEN_TAG=latest
